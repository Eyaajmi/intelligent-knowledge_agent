# Copie ce fichier en `.env` et ajuste. Toutes les variables sont optionnelles.
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:3b-instruct
EMBED_MODEL=nomic-embed-text

# Préfixes de tâche recommandés pour nomic-embed-text (à tester avec scripts.evaluate,
# puis `python -m scripts.reindex` car les embeddings stockés changent) :
# QUERY_PREFIX="search_query: "
# DOCUMENT_PREFIX="search_document: "

DATA_DIR=data
MAX_UPLOAD_MB=50
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MIN_SEMANTIC_SCORE=0.30
MIN_KEYWORD_SCORE=0.15
CORS_ORIGINS=http://localhost:4200
